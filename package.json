{
  "name": "pic-swipe-wipe",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "g:ui": "node scripts/generate.js -ui",
    "g:c": "node scripts/generate.js -c",
    "start": "expo start -c",
    "expo-build-dev": "eas build --platform android --profile development",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android --device",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "generate-docs": "typedoc",
    "prepare": "husky",
    "format": "prettier --write .",
    "clear-test-cache": "test -- --clearCache",
    "test": "jest",
    "test:watch": "jest  --watch",
    "test:clean": "jest  --clearCache && jest --watchAll=false",
    "test:clean:u": "jest  --clearCache && jest --watchAll=false -u",
    "storybook-generate": "sb-rn-get-stories",
    "storybook": "npm run storybook-generate && cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client",
    "storybook:expo-go": "npm run storybook-generate && expo start"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.11.2",
    "@storybook/addon-ondevice-actions": "^10.2.3",
    "@storybook/addon-ondevice-controls": "^10.2.3",
    "@storybook/react": "^10.2.12",
    "@storybook/react-native": "^10.2.3",
    "babel-loader": "^8.4.1",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-media-library": "^18.2.1",
    "expo-navigation-bar": "~5.0.10",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "^55.0.10",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "storybook": "^10.2.12"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "^54.0.17",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react-native-svg-transformer": "^1.5.3",
    "typedoc": "^0.28.17",
    "typescript": "~5.9.2"
  },
  "private": true,
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
